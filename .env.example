# Server-only: URL of the Spring Boot backend (never exposed to the browser).
BACKEND_URL=http://localhost:8080
IMAGE_ALLOWED_HOSTS=images.unsplash.com
# Public origin for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# Optional on Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL); defaults to http://localhost:3000.
SITE_URL=

# Backend only. test = Testing credentials of a test seller. production = live credentials of the real seller
# (set ONLY on the production host; never in dev/staging).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=test
# Numeric Mercado Pago user id that receives the money (collector_id).
MERCADOPAGO_COLLECTOR_ID=
APP_PUBLIC_FRONTEND_URL=
APP_PUBLIC_BACKEND_URL=

# --- Business data (public; shown in footer, legal texts and policies) ---
# "live" removes every demo/test label. Leave empty until real sales are open.
NEXT_PUBLIC_STORE_MODE=
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_TAX_ID=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_RETURN_DAYS=30
NEXT_PUBLIC_HANDLING_TIME=1 a 2 días hábiles
