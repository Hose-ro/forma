# Copy to .env and adjust. Never commit real secrets.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/velora
DATABASE_USERNAME=velora
DATABASE_PASSWORD=change-me
APP_FRONTEND_ORIGIN=http://localhost:3000
# Used as HMAC key for guest cart/order tokens. Generate with: openssl rand -base64 48
APP_SESSION_SECRET=
# true behind HTTPS (production). Keep false for http://localhost.
APP_COOKIE_SECURE=false
APP_OPENAPI_ENABLED=false
# Required with SPRING_PROFILES_ACTIVE=prod. Separate DDL role; never use for runtime queries.
DATABASE_MIGRATION_USERNAME=
DATABASE_MIGRATION_PASSWORD=
# Optional dev admin (only created when both are set and profile=dev)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Backend only. test = Testing credentials of a test seller. production = live credentials of the real seller
# (set ONLY on the production host; never in dev/staging).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=test
# Numeric Mercado Pago user id that receives the money (collector_id).
MERCADOPAGO_COLLECTOR_ID=
APP_PUBLIC_FRONTEND_URL=
APP_PUBLIC_BACKEND_URL=

# --- Shipping (the server computes the charge; the storefront reads it from /api/v1/checkout/shipping) ---
# Flat rate for any state without its own rate.
APP_SHIPPING_FLAT=0
# Free shipping from this subtotal (empty = never).
APP_SHIPPING_FREE_FROM=
# Per-state rates: Ciudad de México=99;Jalisco=149;Nuevo León=149
APP_SHIPPING_ZONES=
# true = deliver ONLY to the states listed in APP_SHIPPING_ZONES.
APP_SHIPPING_ONLY_ZONES=false
APP_SHIPPING_DELIVERY_ESTIMATE=3 a 7 días hábiles

# --- Transactional email (order confirmation + shipment notice). Disabled while SPRING_MAIL_HOST is empty. ---
APP_STORE_NAME=FORMA.
# SPRING_MAIL_HOST=smtp.your-provider.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# Sender on your verified domain, e.g. "FORMA. <pedidos@tudominio.com>"
APP_MAIL_FROM=
# Business inbox: receives a copy of every paid order and customer replies.
APP_ORDERS_NOTIFY_EMAIL=
