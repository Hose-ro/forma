# Copy to .env and adjust. Never commit real secrets.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/velora
DATABASE_USERNAME=velora
DATABASE_PASSWORD=change-me
APP_FRONTEND_ORIGIN=http://localhost:3000
# Used as HMAC key for guest cart/order tokens. Generate with: openssl rand -base64 48
APP_SESSION_SECRET=
# true behind HTTPS (production). Keep false for http://localhost.
APP_COOKIE_SECURE=false
APP_OPENAPI_ENABLED=false
# Required with SPRING_PROFILES_ACTIVE=prod. Separate DDL role; never use for runtime queries.
DATABASE_MIGRATION_USERNAME=
DATABASE_MIGRATION_PASSWORD=
# Optional dev admin (only created when both are set and profile=dev)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Backend only. Use the application's Testing credentials, never live seller credentials.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=test
# Numeric test recipient account id (collector_id).
MERCADOPAGO_COLLECTOR_ID=
APP_PUBLIC_FRONTEND_URL=
APP_PUBLIC_BACKEND_URL=
