# Copy to .env and adjust. Never commit real secrets.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/olvenio
DATABASE_USERNAME=olvenio
DATABASE_PASSWORD=change-me
APP_FRONTEND_ORIGIN=http://localhost:3000
# Used as HMAC key for guest cart/order tokens. Generate with: openssl rand -base64 48
APP_SESSION_SECRET=
# true behind HTTPS (production). Keep false for http://localhost.
APP_COOKIE_SECURE=false
APP_OPENAPI_ENABLED=false
# Required with SPRING_PROFILES_ACTIVE=prod. Separate DDL role; never use for runtime queries.
DATABASE_MIGRATION_USERNAME=
DATABASE_MIGRATION_PASSWORD=
# Optional dev admin (only created when both are set and profile=dev)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Backend only. test = Testing credentials of a test seller. production = live credentials of the real seller
# (set ONLY on the production host; never in dev/staging).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=test
# Numeric Mercado Pago user id that receives the money (collector_id).
MERCADOPAGO_COLLECTOR_ID=
# Optional Stripe (cards and OXXO). Leave empty to hide the method. Webhook endpoint:
# <APP_PUBLIC_BACKEND_URL>/api/v1/webhooks/stripe with the checkout.session.*, payment_intent.* and charge.* events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENVIRONMENT=test
# Optional PayPal (REST app). Webhook endpoint: <APP_PUBLIC_BACKEND_URL>/api/v1/webhooks/paypal with
# CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.* events; PAYPAL_WEBHOOK_ID is that webhook's id.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=test
# Optional Conekta (SPEI by default). Webhook endpoint: <APP_PUBLIC_BACKEND_URL>/api/v1/webhooks/conekta.
# CONEKTA_WEBHOOK_PUBLIC_KEY is the PEM returned by POST /webhook_keys (newlines may be written as \n).
CONEKTA_PRIVATE_KEY=
CONEKTA_WEBHOOK_PUBLIC_KEY=
CONEKTA_ENVIRONMENT=test
CONEKTA_METHODS=bank_transfer
# Production after DNS setup: APP_FRONTEND_ORIGIN=https://olvenio.com,
# APP_PUBLIC_FRONTEND_URL=https://olvenio.com and APP_PUBLIC_BACKEND_URL=https://api.olvenio.com.
APP_PUBLIC_FRONTEND_URL=
APP_PUBLIC_BACKEND_URL=

# --- Shipping (free on every order; only coverage and delivery time are configurable) ---
# States with coverage: Ciudad de México;Jalisco;Nuevo León
APP_SHIPPING_ZONES=
# true = deliver ONLY to the states listed in APP_SHIPPING_ZONES.
APP_SHIPPING_ONLY_ZONES=false
APP_SHIPPING_DELIVERY_ESTIMATE=3 a 7 días hábiles

# --- Post-sale operations ---
# Match NEXT_PUBLIC_RETURN_DAYS in the frontend.
APP_RETURN_DAYS=30
APP_PREPARATION_ALERT_HOURS=24
# Optional Envia labels. Add token and Mexican origin together. Sandbox is the default.
APP_ENVIA_TOKEN=
APP_ENVIA_ORIGIN_JSON=
APP_ENVIA_CARRIERS=estafeta
APP_ENVIA_ENVIRONMENT=sandbox

# --- Transactional email (order confirmation + shipment notice). Disabled while SPRING_MAIL_HOST is empty. ---
APP_STORE_NAME=Olvenio
# SPRING_MAIL_HOST=smtp.your-provider.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# Sender on your verified domain, e.g. "Olvenio <pedidos@olvenio.com>"
APP_MAIL_FROM=
# Business inbox: receives a copy of every paid order and customer replies.
APP_ORDERS_NOTIFY_EMAIL=

# Shared with the storefront (BACKEND_PROXY_SECRET): lets rate limits see each visitor instead of the proxy.
APP_PROXY_SECRET=
# How long an unpaid order keeps its stock; the Mercado Pago preference expires at the same time.
APP_RESERVATION_TTL=24h
# Optional Google Identity Services web client ID for this environment.
APP_GOOGLE_CLIENT_ID=
